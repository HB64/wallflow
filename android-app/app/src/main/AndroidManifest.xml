<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Zonder deze <queries>-declaratie kan startActivity() met het
        impliciete ACTION_DREAM_SETTINGS-intent op Android 11+ (API 30+)
        stil falen door package-visibility restricties, ook als het
        doel-scherm wel degelijk bestaat.
    -->
    <queries>
        <intent>
            <action android:name="android.settings.DREAM_SETTINGS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WallFlowScreensaver">

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TagsActivity"
            android:exported="false"
            android:label="@string/pref_tags_title"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:label="@string/pref_gallery_title"
            android:parentActivityName=".SettingsActivity" />

        <service
            android:name=".WallFlowDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream_info" />
        </service>

    </application>
</manifest>
